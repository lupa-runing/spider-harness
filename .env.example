# SPIDER harness 配置。LLM_PROVIDER 支持两种：
#   openai_compatible —— 任意 OpenAI 兼容网关（campusphere / DeepSeek 官方 / vLLM / Ollama 均可）
#   mock              —— 内置占位实现：事件结构、token 账本、审校裁决全部真实流动，仅生成物为确定性占位
# 填好 key 后把 LLM_PROVIDER 改为 openai_compatible 即切换为真实调用，无需改代码。

LLM_PROVIDER=mock
LLM_BASE_URL=https://llm.campusphere.net/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 空闲心跳广播间隔（秒）；并发任务上限
TOKEN_TICK_SECONDS=1
MAX_CONCURRENT_TASKS=3
